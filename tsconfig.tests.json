{
  // Типы проверок — отдельным проходом.
  //
  // `tsconfig.app.json` исключает `*.vitest.test.ts`, а vitest по умолчанию
  // типы не проверяет вовсе. Поэтому `pnpm check` мог пройти целиком при
  // сломанных типах в проверке, которая на исполнении зелёная. Этот проход
  // закрывает дыру: те же строгие правила, но с проверками внутри.
  "extends": "./tsconfig.app.json",
  "include": [
    "app/**/*.ts",
    "jarvis/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "dist-electron", "apps", "submodules"]
}
