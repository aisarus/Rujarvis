{
  "name": "rujarvis",
  "version": "0.3.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Voice assistant for Windows in Russian and English, driven by your Claude Code subscription",
  "homepage": "https://github.com/aisarus/Rujarvis",
  "bugs": "https://github.com/aisarus/Rujarvis/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/aisarus/Rujarvis.git"
  },
  "author": {
    "name": "Rujarvis contributors"
  },
  "type": "module",
  "main": "dist/app/main.cjs",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "build": "node build.mjs",
    "start": "electron dist/app/main.cjs",
    "dev": "node build.mjs && electron dist/app/main.cjs",
    "typecheck": "tsc -p tsconfig.app.json",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test": "vitest run --config vitest.app.config.ts",
    "check": "pnpm typecheck && pnpm typecheck:tests && pnpm test && pnpm build",
    "jarvis:setup": "tsx scripts/jarvis-setup.ts",
    "jarvis:try": "tsx scripts/jarvis-try.ts",
    "jarvis:talk-check": "tsx scripts/talk-live-check.ts",
    "jarvis:mac-apps-check": "tsx scripts/qa/mac-apps-check.ts",
    "jarvis:focus-check": "tsx scripts/qa/focus-check.ts",
    "jarvis:gpu-stt": "tsx scripts/jarvis-gpu-stt.ts",
    "jarvis:gpu-stt-check": "tsx scripts/qa/gpu-stt-check.ts",
    "jarvis:lecture-check": "tsx scripts/qa/lecture-check.ts",
    "jarvis:lecture-room": "node build.mjs && tsx scripts/qa/lecture-room-check.ts",
    "jarvis:lecture-file-check": "node build.mjs && electron dist/qa/lecture-file-check.cjs",
    "jarvis:lecture-finish": "tsx scripts/jarvis-lecture-finish.ts",
    "jarvis:lecture-model": "tsx scripts/jarvis-lecture-model.ts",
    "jarvis:study-prepare": "tsx scripts/jarvis-study-prepare.ts",
    "jarvis:study-window-check": "node build.mjs && electron dist/qa/study-window-check.cjs",
    "jarvis:roundtrip": "tsx scripts/voice-roundtrip.ts",
    "jarvis:mac-check": "tsx scripts/probe-darwin-driver.ts",
    "jarvis:health": "node scripts/health.mjs",
    "jarvis:icons": "node scripts/make-icons.mjs",
    "jarvis:window-check": "node build.mjs && electron dist/qa/window-check.cjs",
    "jarvis:cua-check": "node build.mjs && electron dist/qa/cua-check.cjs",
    "jarvis:onboarding-check": "node build.mjs && electron dist/qa/onboarding-check.cjs",
    "jarvis:cli-check": "tsx scripts/qa/cli-check.ts",
    "jarvis:download-check": "tsx scripts/qa/download-check.ts",
    "jarvis:browse-check": "node build.mjs && tsx scripts/qa/browse-check.ts",
    "jarvis:browse-agent-check": "node build.mjs && tsx scripts/qa/browse-agent-check.ts",
    "jarvis:browser-check": "tsx scripts/qa/browser-check.ts",
    "jarvis:qa": "node build.mjs && electron dist/qa/acceptance.cjs",
    "jarvis:hands-check": "node build.mjs && tsx scripts/qa/hands-check.ts",
    "jarvis:login-check": "tsx scripts/qa/login-window-check.ts",
    "jarvis:browser-keys-check": "node build.mjs && tsx scripts/qa/browser-keys-check.ts",
    "jarvis:agent-check": "node build.mjs && tsx scripts/qa/agent-check.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "playwright": "1.56.1",
    "sherpa-onnx": "1.12.29",
    "tar-stream": "3.1.8",
    "unbzip2-stream": "1.4.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "electron": "44.4.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
