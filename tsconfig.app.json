{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "app/**/*.ts",
    "jarvis/**/*.ts",
    "scripts/jarvis-*.ts",
    "scripts/probe-*.ts",
    "scripts/qa/*.ts",
    "scripts/talk-live-check.ts",
    "scripts/проверка-*.ts",
    "scripts/dota-*.ts"
  ],
  "exclude": ["**/*.vitest.test.ts"]
}
